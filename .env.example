# Settings for vaultsync on a desktop. Copy this file to .env (in this folder) and fill it in.
# .env is never committed, so the token stays on this machine.
# (In Docker, these settings go in compose.yml instead; see compose.example.yml.)

# The vault folder(s): the folder that contains .obsidian/. Use full paths.
# Several vaults: separate them with ":" on macOS/Linux, ";" on Windows.
#   macOS:   VAULT_PATH=/Users/you/Vaults/Work:/Users/you/Vaults/Personal
#   Windows: VAULT_PATH=C:\Vaults\Work;C:\Vaults\Personal
VAULT_PATH=

# GitHub token with "Contents: Read and write" on the vault repos.
# Leave empty to use the login git already saved (macOS Keychain / Git Credential Manager).
GITHUB_TOKEN=

# Optional, defaults shown:
# DEBOUNCE_SECONDS=30         # wait this long after the last change before syncing
# PULL_INTERVAL_SECONDS=300   # sync at least this often (downloads other devices' changes)
